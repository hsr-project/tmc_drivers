<package format="3">
  <name>tmc_pgr_camera</name>
  <version>2.1.1</version>
  <description>Driver node for Point Gray Cameras.</description>
  <maintainer email="xr-hsr-support@mail.toyota.co.jp">HSR Support</maintainer>
